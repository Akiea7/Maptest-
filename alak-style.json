{
  "version": 8,
  "sources": {
    "ne2_shaded": {
      "maxzoom": 8,
      "tileSize": 256,
      "tiles": [
        "https://tiles.openfreemap.org/natural_earth/ne2sr/{z}/{x}/{y}.png"
      ],
      "type": "raster"
    },
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#ecebe4"
      }
    },
    {
      "id": "natural_earth",
      "type": "raster",
      "source": "ne2_shaded",
      "maxzoom": 8,
      "paint": {
        "raster-opacity": ["interpolate", ["exponential", 1.5], ["zoom"], 0, 0.7, 7, 0.2]
      }
    },
    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "maxzoom": 13,
      "filter": ["==", ["get", "class"], "residential"],
      "paint": {
        "fill-color": "#f4f3ee",
        "fill-opacity": 1
      }
    },
    {
      "id": "landuse_commercial_industrial",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "any",
        ["==", ["get", "class"], "commercial"],
        ["==", ["get", "class"], "industrial"]
      ],
      "paint": {
        "fill-color": "#e6e5df",
        "fill-opacity": 1
      }
    },
    {
      "id": "park_layer",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#d4ebd0",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "landcover_green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "any",
        ["==", ["get", "class"], "grass"],
        ["==", ["get", "class"], "wood"],
        ["==", ["get", "class"], "forest"],
        ["==", ["get", "class"], "farmland"]
      ],
      "paint": {
        "fill-color": "#def0db",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {
        "fill-color": "#7ab5f5",
        "fill-opacity": 1
      }
    },
    {
      "id": "waterway_river",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["all", ["==", ["get", "class"], "river"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": {
        "line-color": "#7ab5f5",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 11, 1, 20, 8]
      }
    },
    {
      "id": "road_minor_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all", 
        ["!=", ["get", "brunnel"], "tunnel"], 
        ["any", ["==", ["get", "class"], "minor"], ["==", ["get", "class"], "service"], ["==", ["get", "class"], "track"], ["==", ["get", "class"], "path"]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#d6d3c9",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 13, 1.5, 20, 20]
      }
    },
    {
      "id": "road_minor_fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all", 
        ["!=", ["get", "brunnel"], "tunnel"], 
        ["any", ["==", ["get", "class"], "minor"], ["==", ["get", "class"], "service"], ["==", ["get", "class"], "track"], ["==", ["get", "class"], "path"]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 13, 0.8, 20, 15]
      }
    },
    {
      "id": "road_major_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all", 
        ["!=", ["get", "brunnel"], "tunnel"], 
        ["any", ["==", ["get", "class"], "motorway"], ["==", ["get", "class"], "trunk"], ["==", ["get", "class"], "primary"], ["==", ["get", "class"], "secondary"], ["==", ["get", "class"], "tertiary"]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#b8b2a5",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 5, 1.5, 14, 7, 20, 28]
      }
    },
    {
      "id": "road_major_fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all", 
        ["!=", ["get", "brunnel"], "tunnel"], 
        ["any", ["==", ["get", "class"], "motorway"], ["==", ["get", "class"], "trunk"], ["==", ["get", "class"], "primary"], ["==", ["get", "class"], "secondary"], ["==", ["get", "class"], "tertiary"]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 5, 0.8, 14, 5, 20, 22]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "maxzoom": 15,
      "paint": {
        "fill-color": "#e2e0d8",
        "fill-outline-color": "#c8c6bc",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "building-3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 15,
      "paint": {
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-color": "#e9e7df",
        "fill-extrusion-height": ["coalesce", ["get", "render_height"], 12],
        "fill-extrusion-opacity": 0.9
      }
    },
    {
      "id": "road_label_major",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "filter": [
        "any",
        ["==", ["get", "class"], "motorway"],
        ["==", ["get", "class"], "trunk"],
        ["==", ["get", "class"], "primary"],
        ["==", ["get", "class"], "secondary"]
      ],
      "minzoom": 10,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:ar"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10, 16, 14]
      },
      "paint": {
        "text-color": "#334155",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    }
  ]
}
